{
    "name":  "diffatlas",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Structural diff and merge tool for JSON, CSV, YAML and images — 100% client-side, no backend, no API keys.",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint .",
                    "test":  "vitest run"
                },
    "keywords":  [
                     "diff",
                     "json-diff",
                     "csv-diff",
                     "merge",
                     "client-side",
                     "react",
                     "typescript"
                 ],
    "author":  "Parth3238",
    "license":  "MIT",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "dependencies":  {
                         "@tanstack/react-virtual":  "^3.14.13",
                         "js-yaml":  "^5.4.2",
                         "jspdf":  "^4.2.1",
                         "lz-string":  "^1.5.0",
                         "papaparse":  "^5.7.0",
                         "react":  "^19.3.0",
                         "react-dom":  "^19.3.0"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@playwright/test":  "^1.63.0",
                            "@tailwindcss/vite":  "^4.3.3",
                            "@types/js-yaml":  "^4.0.9",
                            "@types/papaparse":  "^5.5.2",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.1.1",
                            "eslint":  "^10.10.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "globals":  "^17.12.0",
                            "tailwindcss":  "^4.3.3",
                            "typescript":  "~5.9.3",
                            "typescript-eslint":  "^8.70.0",
                            "vite":  "^8.3.0",
                            "vitest":  "^5.0.1"
                        },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/Parth3238/DiffAtlasPro.git"
                   },
    "homepage":  "https://diff-atlas-pro.vercel.app"
}
